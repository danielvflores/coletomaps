<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CALLE (Ej: Av. Diego Portales) -->
            <TextView
                android:id="@+id/tvItemCalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calle No Especificada"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvItemHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- TIPO DE INCIDENTE (Ej: Congestión vehicular) -->
        <TextView
            android:id="@+id/tvItemTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tipo de Incidente"
            android:textStyle="italic"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- DESCRIPCIÓN -->
        <TextView
            android:id="@+id/tvItemDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Descripción del reporte..."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />

        <!-- VOTOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvVotosPositivos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👍 0"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvVotosNegativos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👎 0"
                android:textColor="#F44336"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>