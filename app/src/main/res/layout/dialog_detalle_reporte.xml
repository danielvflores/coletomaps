<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <!-- Barra estetica superior para indicar que se desliza -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#D3D3D3"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Cabecera: Tipo de Incidente -->
    <TextView
        android:id="@+id/tvTvTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCIDENTE VEHICULAR"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Hora del reporte -->
    <TextView
        android:id="@+id/tvTvHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reportado a las 14:30"
        android:textColor="#757575"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <!-- Descripción del incidente -->
    <TextView
        android:id="@+id/tvTvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sin descripción adicional."
        android:textColor="#333333"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <!-- Alerta de restricción (Invisible por defecto) -->
    <TextView
        android:id="@+id/tvAlertaRestriccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 Modo lectura: Estás muy lejos o ya votaste."
        android:textColor="#D32F2F"
        android:textSize="13sp"
        android:textStyle="italic"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <!-- Contenedor de Botones Colectivos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnVotoSi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SÍ, SIGUE"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginRight="8dp"/>

        <Button
            android:id="@+id/btnVotoNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NO, YA PASÓ"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>
</LinearLayout>